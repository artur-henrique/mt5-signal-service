# --- Telegram (obtenha em https://my.telegram.org) ---
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=coloque_seu_api_hash_aqui
TELEGRAM_CHANNEL=@nome_ou_id_do_canal

# --- Anthropic (fallback do parser via IA para comandos em texto livre) ---
ANTHROPIC_API_KEY=coloque_sua_api_key_aqui

# --- Servidor ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Segurança ---
# Token de administração usado pelo manage_clients.py e por endpoints /admin/*
ADMIN_TOKEN=troque_por_um_token_forte_aleatorio
